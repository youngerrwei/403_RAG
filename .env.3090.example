# =========================
# 单卡 RTX 3090（24GB）部署配置模板
# 将本文件复制为 .env 即可在单张 3090 上运行整套 RAG 栈（Embedding/Reranker/LLM 同卡）。
# 模型优化核心：VLLM_QUANTIZATION=bitsandbytes（4-bit），无需下载任何额外权重。
# 本模板基于本机 .env 生成，仅覆盖单卡相关项；其余检索/切块参数与原配置一致。
# =========================
VLLM_CUDA_DEVICES=0

# =========================
# vLLM 配置
# =========================
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=lab-secret-key
# vLLM 推理模型路径（本地路径，通过 download_model.sh 下载）
VLLM_MODEL_NAME=./models/Qwen3-8B-Instruct
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
VLLM_GPU_UTIL=0.6
# 4-bit 量化后权重约 5.7GB，单卡 KV 余量比 fp16 更充裕；8192 仍为同栈共享显存留足余量
VLLM_MAX_MODEL_LEN=8192
VLLM_ENABLE_PREFIX_CACHING=true
# —— 单卡 3090 模型优化（关键） ——
# 用 vLLM 内置 BitsAndBytes 在加载时把本地 fp16 Qwen3-8B 量化为 4-bit（无需下载量化权重），
# 权重由 16GB 降至约 5.7GB，可与 bge-m3(≈2.3GB)+reranker(≈1.1GB) 同卡共存于 24GB。
# 注意：bnb 推理速度略慢于 fp16（用显存换速度），单卡场景可接受；追求速度可改用 AWQ/GPTQ-Int4 预量化权重。
VLLM_QUANTIZATION=bitsandbytes
# 关闭 Qwen3 思考链（减少单卡延迟与输出长度）
VLLM_ENABLE_THINKING=false
# 分块预填充：提升单卡混合预填/解码吞吐
VLLM_ENABLE_CHUNKED_PREFILL=true
VLLM_STARTUP_TIMEOUT=300
STARTUP_PROBE_TIMEOUT=5

# =========================
# Qdrant 配置
# =========================
QDRANT_HOST=172.18.216.71
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=lab_knowledge_base
# !!是否删除旧的集合（增量请选择false）!!
QDRANT_RECREATE_COLLECTION=false

# =========================
# Embedding 配置
# =========================
EMBEDDING_MODEL_NAME=./models/bge-m3
EMBEDDING_DEVICE=cuda:0

# =========================
# Reranker 配置
# =========================
RERANKER_MODEL_NAME=./models/bge-reranker-v2-m3
RERANKER_DEVICE=cuda:0

# =========================
# 文档与切块参数
# =========================
DOCS_PATH=/mnt/cpu_share
PARENT_CHUNK_SIZE=1500
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=300
CHILD_CHUNK_OVERLAP=50
INITIAL_RETRIEVAL_K=64
FINAL_TOP_K=16

# =========================
# 混合检索配置
# =========================
ENABLE_HYBRID_SEARCH=true
BM25_WEIGHT=0.3
DENSE_WEIGHT=0.7
RRF_K=60
KEYWORD_BOOST=1.05
TITLE_BOOST=1.08
HYBRID_FILE_CONTEXT_BUDGET=1500

# =========================
# 上下文管理
# =========================
# 注意：vLLM 上下文窗口=8192 tokens（见 VLLM_MAX_MODEL_LEN），需保证 input + output 不超此限制
# input: context(3000字符≈2000tokens) + history(1500tokens) + prompt(250tokens) + question(100tokens) ≈ 3850 tokens
# agent 模式由 AGENT_CONTEXT_MAX_TOKENS 按窗口自动推导输入预算，会主动折叠超长上下文
# output: RESPONSE_MAX_TOKENS=2048 tokens
# 总计: 3850 + 2048 = 5898 tokens < 8192 ✓
MAX_CONTEXT_CHARS=3000
MAX_HISTORY_TOKENS=1500
# 对话历史软轮次上限：超过该轮数的最旧轮次在 token 截断前先折叠压缩，保留意图线索
HISTORY_SOFT_TURN_LIMIT=16
# 历史超预算时折叠旧轮而非直接丢弃（false 退化为旧的硬截断行为）
HISTORY_COMPACT_ENABLED=true
# read_file 工具单次读取的字符预算（读取文件/目录拼接均受此上限约束）
READ_FILE_MAX_CHARS=6000
# token 级上下文护栏：按本模板窗口 8192 自动推导输入预算（预留输出 2048），
# 超预算时折叠上下文、必要时切换到精简 ReAct 系统提示词，避免 400 超长错误。
# 0 = 自动推导 = VLLM_MAX_MODEL_LEN - RESPONSE_MAX_TOKENS - AGENT_CONTEXT_SAFETY_TOKENS
AGENT_CONTEXT_MAX_TOKENS=0
AGENT_CONTEXT_SAFETY_TOKENS=256

# =========================
# 知识库路径
# =========================
KNOWLEDGE_BASE_ROOT=/mnt/cpu_share
ENABLE_FILESYSTEM_TOOL=true
FILE_SEARCH_LIMIT=200
DIRECTORY_CHILD_LIMIT=10

# =========================
# DEBUG 配置
# =========================
DEBUG_MODE=true

# =========================
# 日志配置
# =========================
LOG_DIR=logs
LOG_LEVEL=DEBUG
LOG_FILE_PREFIX=rag
LOG_MAX_DAYS=7

# =========================
# Web 服务配置
# =========================
HISTORY_RETENTION_DAYS=7
HISTORY_DAILY_MAX=200
USERS_FILE=config/users.json
FLASK_DEBUG=false
WEBAPP_PORT=5000
WEBAPP_STARTUP_TIMEOUT=60
HEALTHCHECK_TIMEOUT=3
RUNTIME_RETRY_INTERVAL=30

# ========== 新增配置 ==========
# Flask 安全密钥（建议替换为随机生成的强密钥）
FLASK_SECRET_KEY=__REPLACE_WITH_RANDOM_HEX__

# Reranker 分数阈值（低于此分数的文档将被过滤）
RERANKER_SCORE_THRESHOLD=0.3

# LLM 生成参数
RESPONSE_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# MCP 旁路（仅限本机访问；setup_mcp.sh 自动生成 Token）
MCP_INTERNAL_TOKEN=
MCP_INTERNAL_BASE_URL=http://127.0.0.1:5000
MCP_HTTP_TIMEOUT=120
MCP_QUERY_MAX_CHARS=4000
MCP_RESULT_LIMIT=6
MCP_RESULT_MAX_CHARS=1500

# 入库批处理大小
INGEST_BATCH_SIZE=64
EMBEDDING_INIT_TIMEOUT=300

# 最小 chunk 长度（短于此长度的块将被过滤）
MIN_CHUNK_LENGTH=120

# 父块独立集合名称
QDRANT_PARENT_COLLECTION=lab_knowledge_base_parents

# =========================
# HyDE (Hypothetical Document Embeddings) 配置
# =========================
ENABLE_HYDE=true

# =========================
# 并发与功能开关
# =========================
MAX_CONCURRENT_REQUESTS=20
HTTPS_ENABLED=false

# 独立 conda 环境
RAG_CONDA_ENV=rag
VLLM_CONDA_ENV=rag-vllm
MINERU_CONDA_ENV=rag-mineru
MCP_CONDA_ENV=rag-mcp

# 文档转换可靠性参数
CONVERT_TIMEOUT=300
CONVERT_TIMEOUT_PER_MB=20
CONVERT_MAX_TIMEOUT=3600
CONVERT_MAX_RETRIES=2
MAX_FILE_SIZE_MB=200
MIN_OUTPUT_SIZE=10
CONVERT_TABLE_VLM_FALLBACK=true
TABLE_FLATTENED_LINE_MIN_CHARS=240

# =========================
# 入库摘要增强配置
# =========================
ENABLE_SUMMARY_AUGMENTATION=true
SUMMARY_VLLM_TIMEOUT=30
SUMMARY_VLLM_RETRIES=3
SUMMARY_MAX_WORKERS=3
SUMMARY_MAX_TOKENS=300
SUMMARY_INJECTION_MODE=both
ENABLE_SUMMARY_CACHE=true
SUMMARY_CACHE_DIR=./data/summary_cache
