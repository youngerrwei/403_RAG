# =========================
# GPU 配置
# =========================
# GPU 分配策略（4 卡环境）：
# - GPU 2: Embedding (bge-m3) + Reranker (bge-reranker-v2-m3)
# - GPU 3: vLLM 推理服务 (Qwen3-8B-Instruct)
# 如需修改，请确保 vLLM 与 Embedding/Reranker 不在同一张卡上
VLLM_CUDA_DEVICES=3

# =========================
# vLLM 配置
# =========================
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=lab-secret-key
# vLLM 推理模型路径（本地路径，通过 download_model.sh 下载）
VLLM_MODEL_NAME=models/Qwen3-8B-Instruct
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
VLLM_GPU_UTIL=0.85
VLLM_MAX_MODEL_LEN=6000
VLLM_ENABLE_PREFIX_CACHING=true

# =========================
# Qdrant 配置
# =========================
QDRANT_HOST=172.18.216.71
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=lab_knowledge_base
# !!是否删除旧的集合（增量请选择false）!!
QDRANT_RECREATE_COLLECTION=true

# =========================
# Embedding 配置
# =========================
EMBEDDING_MODEL_NAME=models/bge-m3
EMBEDDING_DEVICE=cuda:2

# =========================
# Reranker 配置
# =========================
RERANKER_MODEL_NAME=models/bge-reranker-v2-m3
RERANKER_DEVICE=cuda:2

# =========================
# 文档与切块参数
# =========================
DOCS_PATH=/mnt/cpu_share
PARENT_CHUNK_SIZE=1500
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=300
CHILD_CHUNK_OVERLAP=50
INITIAL_RETRIEVAL_K=64
FINAL_TOP_K=16

# =========================
# 混合检索配置
# =========================
ENABLE_HYBRID_SEARCH=true
BM25_WEIGHT=0.3
DENSE_WEIGHT=0.7
RRF_K=60
KEYWORD_BOOST=1.05
TITLE_BOOST=1.08
HYBRID_FILE_CONTEXT_BUDGET=1500

# =========================
# 上下文管理
# =========================
# 注意：vLLM总容量=8192 tokens，需保证 input + output 不超此限制
# input: context(3000字符≈2000tokens) + history(1500tokens) + prompt(250tokens) + question(100tokens) ≈ 3850 tokens
# output: RESPONSE_MAX_TOKENS=2048 tokens
# 总计: 3850 + 2048 = 5898 tokens < 8192 ✓
MAX_CONTEXT_CHARS=3000
MAX_HISTORY_TOKENS=1500

# =========================
# 知识库路径
# =========================
KNOWLEDGE_BASE_ROOT=/mnt/cpu_share
ENABLE_FILESYSTEM_TOOL=true
FILE_SEARCH_LIMIT=200
DIRECTORY_CHILD_LIMIT=10

# =========================
# DEBUG 配置
# =========================
DEBUG_MODE=true

# =========================
# 日志配置
# =========================
LOG_DIR=logs
LOG_LEVEL=DEBUG
LOG_FILE_PREFIX=rag
LOG_MAX_DAYS=7

# =========================
# Web 服务配置
# =========================
HISTORY_RETENTION_DAYS=7
HISTORY_DAILY_MAX=200

# ========== 新增配置 ==========
# Flask 安全密钥（建议替换为随机生成的强密钥）
FLASK_SECRET_KEY=lab403-rag-secret-key-change-me-in-production

# Reranker 分数阈值（低于此分数的文档将被过滤）
RERANKER_SCORE_THRESHOLD=0.3

# LLM 生成参数
RESPONSE_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# 入库批处理大小
INGEST_BATCH_SIZE=64

# 最小 chunk 长度（短于此长度的块将被过滤）
MIN_CHUNK_LENGTH=120

# 父块独立集合名称
QDRANT_PARENT_COLLECTION=lab_knowledge_base_parents

# =========================
# HyDE (Hypothetical Document Embeddings) 配置
# =========================
ENABLE_HYDE=true

# =========================
# 并发与功能开关
# =========================
MAX_CONCURRENT_REQUESTS=20
HTTPS_ENABLED=false

# =========================
# 入库摘要增强配置
# =========================
ENABLE_SUMMARY_AUGMENTATION=true
SUMMARY_VLLM_TIMEOUT=30
SUMMARY_VLLM_RETRIES=3
SUMMARY_MAX_WORKERS=3
SUMMARY_MAX_TOKENS=300
SUMMARY_INJECTION_MODE=both
ENABLE_SUMMARY_CACHE=true
SUMMARY_CACHE_DIR=./data/summary_cache