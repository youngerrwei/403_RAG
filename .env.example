# =========================
# GPU、转换参数与独立 conda 环境
# =========================
VLLM_CUDA_DEVICES=3
RAG_CONDA_ENV=rag
VLLM_CONDA_ENV=rag-vllm
MINERU_CONDA_ENV=rag-mineru
MCP_CONDA_ENV=rag-mcp
CONVERT_TIMEOUT=300
CONVERT_TIMEOUT_PER_MB=20
CONVERT_MAX_TIMEOUT=3600
CONVERT_MAX_RETRIES=2
MAX_FILE_SIZE_MB=200
MIN_OUTPUT_SIZE=10

# =========================
# vLLM 配置
# =========================
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=lab-secret-key
VLLM_MODEL_NAME=./models/Qwen3-8B-Instruct
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
VLLM_GPU_UTIL=0.85
VLLM_MAX_MODEL_LEN=6000
VLLM_ENABLE_PREFIX_CACHING=true
VLLM_STARTUP_TIMEOUT=300
VLLM_INFERENCE_PROBE_TIMEOUT=15
VLLM_ENABLE_THINKING=false
STARTUP_PROBE_TIMEOUT=5

# =========================
# Qdrant 配置
# =========================
QDRANT_HOST=172.18.216.71
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=lab_knowledge_base
QDRANT_PARENT_COLLECTION=lab_knowledge_base_parents
QDRANT_RECREATE_COLLECTION=false

# =========================
# Embedding / Reranker
# =========================
EMBEDDING_MODEL_NAME=./models/bge-m3
EMBEDDING_DEVICE=cuda:2
RERANKER_MODEL_NAME=./models/bge-reranker-v2-m3
RERANKER_DEVICE=cuda:2
RERANKER_SCORE_THRESHOLD=0.3

# =========================
# 文档、切块与入库
# =========================
DOCS_PATH=/mnt/cpu_share
KNOWLEDGE_BASE_ROOT=/mnt/cpu_share
PARENT_CHUNK_SIZE=1500
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=300
CHILD_CHUNK_OVERLAP=50
MIN_CHUNK_LENGTH=120
ENABLE_TABLE_SEMANTIC_ENRICHMENT=true
TABLE_SEMANTIC_MAX_ROWS=20
# 语义转写跳过 U+FFFD 占比超过该值的行（OCR 残缺目录页点线），避免把噪声再复制一遍
TABLE_SEMANTIC_MAX_REPLACEMENT_RATIO=0.15
CONVERT_TABLE_VLM_FALLBACK=true
TABLE_FLATTENED_LINE_MIN_CHARS=240
INGEST_BATCH_SIZE=64
EMBEDDING_INIT_TIMEOUT=300
# Markdown 结构保护：标题（含 ####）、代码块、表格与公式按原子块处理
ENABLE_MARKDOWN_STRUCTURE_GUARD=true
# 向量化前缀注入文档路径（小组/设备/Manuals）语义
ENABLE_PATH_CONTEXT_PREFIX=true
# 质量过滤：特殊字符占比上限（Markdown/LaTeX 符号已纳入白名单）
CHUNK_FILTER_SPECIAL_CHAR_RATIO=0.25
# 含结构化转写或代码围栏的块豁免长度/字符占比过滤
ENABLE_TABLE_FILTER_EXEMPTION=true
# 单个文档加载失败即中止入库，避免静默漏文档
INGEST_MAX_FAILED_FILES=0
# Qdrant payload 索引缺失时直接失败而非静默继续
QDRANT_INDEX_FAIL_FAST=true

# =========================
# 检索与上下文
# =========================
INITIAL_RETRIEVAL_K=64
FINAL_TOP_K=16
ENABLE_HYBRID_SEARCH=true
BM25_WEIGHT=0.3
DENSE_WEIGHT=0.7
RRF_K=60
KEYWORD_BOOST=1.05
TITLE_BOOST=1.08
HYBRID_FILE_CONTEXT_BUDGET=1500
MAX_CONTEXT_CHARS=3000
MAX_HISTORY_TOKENS=1500
ENABLE_HYDE=true
ENABLE_FILESYSTEM_TOOL=true
FILE_SEARCH_LIMIT=200
CATALOG_SCAN_LIMIT=20000
DIRECTORY_CHILD_LIMIT=200
# 目录枚举单次遍历快照缓存：消除每次请求两次全盘 os.walk 的网络盘 IO
ENABLE_CATALOG_SNAPSHOT_CACHE=true
CATALOG_SNAPSHOT_TTL=300
# 排除 .svn/.git 等版本控制与隐藏目录，避免把噪声目录误当成设备
CATALOG_EXCLUDE_HIDDEN_DIRS=true
# 目录树快照遍历上限（目录数）；默认 200000 以覆盖完整语料目录树。
# 大共享盘下若仍截断，靠后的目录（如 设备操作指南/VLP小组）会缺失，
# 导致 file_list / hybrid 目录枚举把名称子串相近的噪声路径当成命中。
CATALOG_MAX_TRAVERSAL=200000
# hybrid 目录驱动查询去重后的最大 Dense 路数（完整设备清单仍由目录枚举结果提供）
MAX_HYBRID_QUERIES=8
# 多路检索预算：Dense 查询与 HyDE 假设文档分开计数，避免相互截断
MAX_DENSE_QUERIES=4
MAX_HYDE_QUERIES=2
# MatchText should 条件总数上限，按字段优先级分配
MAX_SPARSE_CONDITIONS=30
# 问题改写使用最近对话历史消解代词
ENABLE_HISTORY_AWARE_REWRITE=true
# 检索缓存键中的索引版本；入库逻辑变更后手动递增以自动失效旧缓存
# v3.2.0：表格转写跳过 OCR 替换符噪声行，page_content 变更，已递增至 2
# v3.3.0 配置化外置保持 page_content 逐字一致，版本维持 2（本轮零重建）
RETRIEVAL_INDEX_VERSION=2
# ===== v3.3.0 配置化检索规则与语料驱动词典 =====
# 结构化检索规则词典（词表/答案模板/表格恢复模板），标准库 json 解析，零新增依赖
LEXICON_PATH=config/retrieval_lexicon.json
# 由 scripts/build_corpus_lexicon.py 从语料 rel_path 离线生成的派生词典
CORPUS_LEXICON_PATH=data/corpus_lexicon.json
# 启用语料派生词典的小组别名；关闭则回退规则词典里的静态别名
ENABLE_CORPUS_LEXICON=true
# 变量格式表特判能力开关；关闭后走通用检索 + LLM 回答
ENABLE_NOTATION_SPECIALIZATION=true
# 证据加权稳定重排（仅影响引用顺序，不改召回集合与上下文内容）
ENABLE_EVIDENCE_RERANK=true
EVIDENCE_RERANK_WEIGHT=0.12
# 强证据先验：日期/文档标题词元/型号精确命中身份字段时的加性加分（封顶），
# 让语义重排在具体日期、专名等长尾意图失真时仍能回归正确文档
EVIDENCE_PRIOR_WEIGHT=0.12
EVIDENCE_PRIOR_CAP=0.24
# 知识库覆盖度分级阈值（与 rerank 分数同口径）
COVERAGE_HIGH_THRESHOLD=0.7
COVERAGE_MEDIUM_THRESHOLD=0.5
COVERAGE_LOW_THRESHOLD=0.3
# 重排查询：both=原始问题+改写问题，rewritten=仅改写问题
RERANK_QUERY_MODE=both
# 全部候选低于阈值时是否仍保底返回 1 条（关闭可避免假引用）
RERANKER_ALLOW_LOW_SCORE_FALLBACK=false
# 重排过滤策略：相对 Top-1 比例与最少保留条数（0=关闭，保持仅绝对阈值）
RERANKER_RELATIVE_RATIO=0
RERANKER_MIN_KEEP=0
# 拒答闸门：最终父块关键词零命中且 Top-1 分数低于下限时判为知识库无答案
ENABLE_ANSWERABILITY_GATE=true
ANSWERABILITY_TOP_SCORE_FLOOR=0.90
ANSWERABILITY_MIN_KEYWORD_HITS=1
# 原始问题与召回文档身份字段的中文 2-gram 最少重合数，作为第三条通用证据
ANSWERABILITY_MIN_OVERLAP_HITS=2
# MatchText 检索词元预算（型号词元化修复后需略放大）
MAX_SPARSE_TERMS=12
# 父块展开预算与最终上下文预算解耦，限制单一来源垄断候选
PARENT_EXPAND_MAX_CHARS=9000
PARENT_MAX_SINGLE_CHARS=1500
PARENT_MAX_PER_SOURCE=3
# 变量格式表命中块的加分上限（取代写死 1.0）
NOTATION_MATCH_BONUS=0.15
# 上下文组装时过滤超长链接与 OCR 噪声
ENABLE_CONTEXT_NOISE_FILTER=true

# =========================
# Web、健康检查与生成
# =========================
# 首次安装时 scripts/setup_env.sh 会自动生成随机值；手工部署时必须填入至少 32 字符的随机密钥。
FLASK_SECRET_KEY=
USERS_FILE=config/users.json
FLASK_DEBUG=false
WEBAPP_PORT=5000
WEBAPP_STARTUP_TIMEOUT=60
HEALTHCHECK_TIMEOUT=3
RUNTIME_RETRY_INTERVAL=30
HISTORY_RETENTION_DAYS=7
HISTORY_DAILY_MAX=200
MAX_CONCURRENT_REQUESTS=20
HTTPS_ENABLED=false
RESPONSE_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# =========================
# MCP 旁路（仅限本机访问）
# =========================
# scripts/setup_mcp.sh 会自动生成随机值；留空时 Web 内部 MCP API 保持禁用。
MCP_INTERNAL_TOKEN=
MCP_INTERNAL_BASE_URL=http://127.0.0.1:5000
MCP_HTTP_TIMEOUT=120
MCP_QUERY_MAX_CHARS=4000
MCP_RESULT_LIMIT=6
MCP_RESULT_MAX_CHARS=1500

# =========================
# 入库摘要增强
# =========================
ENABLE_SUMMARY_AUGMENTATION=true
SUMMARY_VLLM_TIMEOUT=30
SUMMARY_VLLM_RETRIES=3
SUMMARY_MAX_WORKERS=3
SUMMARY_MAX_TOKENS=300
SUMMARY_INJECTION_MODE=both
ENABLE_SUMMARY_CACHE=true
SUMMARY_CACHE_DIR=./data/summary_cache

# =========================
# 日志与调试
# =========================
DEBUG_MODE=true
LOG_DIR=logs
LOG_LEVEL=DEBUG
LOG_FILE_PREFIX=rag
LOG_MAX_DAYS=7

# ---- 可选增强：有界全文候选召回（origin lexical_retrieval 通道）----
# 默认关闭；开启后作为稀疏检索的补充候选通道，不改变 3.4.0 主检索结果。
ENABLE_LEXICAL_RETRIEVAL=false
LEXICAL_CANDIDATE_LIMIT=256
LEXICAL_MAX_TERMS=8
LEXICAL_TIMEOUT=10
# 自适应兜底：问题含长纯数字词元（日期戳/编号）且首轮召回零命中时，
# 自动启用本地词边界匹配补召回，修复 Qdrant MatchText 对纯数字失效。
# 默认开启；按词元形态判定，不含任何用例语义。
ENABLE_ADAPTIVE_LEXICAL_RECALL=true
ADAPTIVE_LEXICAL_MIN_DIGITS=6
ADAPTIVE_LEXICAL_TOP_K=16

# ---- ReAct Agent 编排层 ----
# 多轮检索步数预算（单一编排器；非流式入口消费同一事件流）
AGENT_MAX_STEPS=4
# 整个 Agent 轮次总耗时预算（秒），超时后优雅收敛
AGENT_TOTAL_TIMEOUT_S=240
# 预算耗尽兜底里附带的部分依据摘要长度（0 表示不附带）
AGENT_FALLBACK_SNIPPET_CHARS=300
# 抑制「同一工具 + 完全相同参数」的重复调用，避免多轮搜索空转耗尽预算
AGENT_REPEAT_ACTION_GUARD=true
# 多轮上下文有界：注入 LLM 的单条工具结果上限、保留完整结果的近期轮数
AGENT_OBSERVATION_MAX_CHARS=2000
AGENT_KEEP_RECENT_OBSERVATIONS=2
# 空转轮（重复抑制/过早 Answer 拦截）上限，不占用工具步数预算
AGENT_MAX_IDLE_STEPS=2
# 预算用尽后给模型一次「基于已有证据作答」的收敛轮（关闭可省一次 LLM 调用）
AGENT_FINAL_CONVERGE_ROUND=true
